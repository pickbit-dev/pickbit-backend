{
  "name": "auth-outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",
    "database.hostname": "mysql",
    "database.port": "3306",
    "database.user": "debezium",
    "database.password": "debezium",
    "database.server.id": "1001",
    "database.connectionTimeZone": "Asia/Seoul",
    "topic.prefix": "pickbit-auth",
    "database.include.list": "pickbit_auth_server",
    "table.include.list": "pickbit_auth_server.out_box_event",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "schema-history.auth-outbox",
    "include.schema.changes": "false",
    "snapshot.mode": "initial",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "event_id",
    "transforms.outbox.table.field.event.key": "aggregate_id",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.route.by.field": "entity",
    "transforms.outbox.route.topic.replacement": "${routedByValue}-topic",
    "transforms.outbox.table.fields.additional.placement": "event_id:header:event_id,event_type:header:action",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.storage.StringConverter"
  }
}
