# EC2의 /opt/pickbit/pickbit-backend/.env 로 복사해서 채운다.
# docker compose 가 자동으로 읽는다.

# 볼륨 이름이 <project>_<volume> 으로 만들어지므로 반드시 고정한다.
# 체크아웃 디렉터리 이름이 바뀌어도 기존 MySQL/Kafka 볼륨을 계속 쓰기 위함.
COMPOSE_PROJECT_NAME=pickbit-backend

# GHCR 이미지 소유자 (GitHub 사용자명 또는 조직명, 소문자)
GHCR_OWNER=your-github-username

# 배포할 이미지 태그. 백엔드와 프론트가 별도 레포라 태그를 분리한다.
# CI가 각자 커밋 SHA로 덮어쓰며, 롤백할 때는 한쪽만 과거 SHA로 되돌릴 수 있다.
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# --- 최초 부팅 전용 ---
# Flyway가 없어서 빈 스키마에 validate를 걸면 전 서비스가 기동에 실패한다.
# 최초 1회만 아래 두 줄의 주석을 풀어 스키마를 만든 뒤, 다시 주석 처리하고 재기동할 것.
# 자세한 절차는 document/operations/aws-ec2-deployment.md 참고.
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
# BATCH_JDBC_INITIALIZE_SCHEMA=always
